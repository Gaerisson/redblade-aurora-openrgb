<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RedBladePlus-Studio</AssemblyName>
    <RootNamespace>RedBladePlus.Studio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.12.0</Version>
    <ApplicationIcon>Resources/redblade.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/studio</PathMap>
    <HelperDirectory Condition="'$(HelperDirectory)' == ''">$(MSBuildProjectDirectory)/../../../work/sonixflasher-3.1.0</HelperDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="Resources/keyboard-layout.json" LogicalName="layout.json" />
    <EmbeddedResource Include="../assets/redblade-plus.png" LogicalName="brand.png" />
    <EmbeddedResource Include="Web/index.html" LogicalName="web.index.html" />
    <EmbeddedResource Include="Web/styles.css" LogicalName="web.styles.css" />
    <EmbeddedResource Include="Web/fn-guide.js" LogicalName="web.fn-guide.js" />
    <EmbeddedResource Include="Web/map-viewer.js" LogicalName="web.map-viewer.js" />
    <EmbeddedResource Include="Web/app.js" LogicalName="web.app.js" />
    <EmbeddedResource Include="Resources/redblade.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="../docs/assets/shortcuts.png" LogicalName="shortcuts.png" />
    <!-- This is a raw PNG served by the primary assembly, not a culture satellite. -->
    <EmbeddedResource Include="../docs/assets/shortcuts.fr.png" LogicalName="shortcuts.fr.png" WithCulture="false" />
    <EmbeddedResource Include="../dist/manifest.json" LogicalName="full.manifest.json" />
    <EmbeddedResource Include="../dist/manifest-core.json" LogicalName="core.manifest.json" />
    <EmbeddedResource Include="../dist/redblade-fs-aurora-via.bin" LogicalName="full.bin" />
    <EmbeddedResource Include="../dist/redblade-fs-openrgb-core.bin" LogicalName="core.bin" />
    <EmbeddedResource Include="$(HelperDirectory)/sonixflasher.exe" LogicalName="sonixflasher.exe" Condition="Exists('$(HelperDirectory)/sonixflasher.exe')" />
    <EmbeddedResource Include="$(HelperDirectory)/libusb-1.0.dll" LogicalName="libusb-1.0.dll" Condition="Exists('$(HelperDirectory)/libusb-1.0.dll')" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
